# ============================================================
# ARTHANA WEDDING & EVENT MANAGEMENT - ENVIRONMENT VARIABLES
# ============================================================
# PENTING:
# 1. File ini adalah TEMPLATE (.env.example).
# 2. Buat salinan bernama .env.local untuk dijalankan di lokal.
# 3. Masukkan variabel-variabel ini di Vercel Dashboard:
#    Project Settings -> Environment Variables.
# 4. JANGAN PERNAH mengupload .env.local ke GitHub!
# ============================================================

# Kredensial Login Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_rahasia_anda_disini

# Kunci Rahasia untuk Enkripsi Token Sesi (Ketik string acak panjang)
SESSION_SECRET=arthana_super_secret_session_token_key_2026_xyz987

# URL Google Apps Script Web App (Database Google Sheets)
# Dapatkan dari: Google Sheets -> Extensions -> Apps Script -> Deploy as Web App
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_CONTOH_DEPLOYMENT_ID/exec

# Token Rahasia Google Sheets (Opsional, jika Anda pasang proteksi di Apps Script)
GOOGLE_SHEETS_SECRET=
